[Desktop Entry]
Type=Application
Name=zen-relay
Comment=Transparent relay in front of zen-proxy that rotates pinned tunnels
# zen-install.sh writes a copy of this file for your install. For a manual
# install, keep the script in ~/.local/bin (or adjust the path).
Exec=sh -c 'exec "$HOME/.local/bin/start-zen-relay.sh"'
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
