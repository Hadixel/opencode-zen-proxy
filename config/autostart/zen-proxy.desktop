[Desktop Entry]
Type=Application
Name=zen-proxy
Comment=Dedicated Xray instance for OpenCode Zen traffic
# zen-install.sh writes a copy of this file for your install. For a manual
# install, keep the script in ~/.local/bin (or adjust the path).
Exec=sh -c 'exec "$HOME/.local/bin/start-zen-proxy.sh"'
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
