{
  "//": "Example dedicated Xray instance for OpenCode Zen traffic.",
  "//2": "Serves an HTTP+SOCKS (mixed) proxy on 127.0.0.1:10901 and spreads",
  "//3": "requests over several upstream servers with a random balancer, so each",
  "//4": "tunnel can use a different exit IP (free-tier allowance is per exit IP).",
  "//5": "Put bin/zen-relay.js in front (127.0.0.1:10900 -> 10901) so OpenCode's",
  "//6": "pooled tunnels are rotated and do not pin a spent exit.",
  "//7": "Replace the placeholder servers with your own. Keep this file private.",
  "//8": "geosite:/geoip: rules need XRAY_LOCATION_ASSET pointing at the .dat files.",
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      {
        "address": "https://8.8.8.8/dns-query",
        "tag": "remote-dns"
      },
      {
        "address": "8.8.8.8"
      }
    ],
    "queryStrategy": "UseIP"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10901,
      "protocol": "mixed",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ],
        "routeOnly": true
      },
      "tag": "mixed-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10954,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "8.8.8.8",
        "network": "tcp,udp",
        "port": 53
      },
      "tag": "dns-in"
    }
  ],
  "outbounds": [
    {
      "tag": "s1",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "server1.example.com",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "encryption": "none",
                "flow": ""
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "server1.example.com",
          "fingerprint": "firefox"
        },
        "wsSettings": {
          "host": "server1.example.com",
          "path": "/"
        }
      }
    },
    {
      "tag": "s2",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "server2.example.com",
            "port": 443,
            "password": "REPLACE_ME"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "server2.example.com",
          "fingerprint": "firefox"
        },
        "wsSettings": {
          "host": "server2.example.com",
          "path": "/"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "8.8.8.8",
        "port": 53
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP"
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "balancers": [
      {
        "tag": "zenbal",
        "selector": [
          "s1",
          "s2"
        ],
        "strategy": {
          "type": "random"
        }
      }
    ],
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "mixed-in"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns-in"
        ],
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "inboundTag": [
          "remote-dns"
        ],
        "balancerTag": "zenbal"
      },
      {
        "type": "field",
        "inboundTag": [
          "dns"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "udp",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "network": "tcp",
        "balancerTag": "zenbal"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "connIdle": 120,
        "handshake": 8,
        "uplinkOnly": 5,
        "downlinkOnly": 5
      }
    }
  }
}
