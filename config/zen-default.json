    {
      "listen": "127.0.0.1",
      "port": 10954,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "1.1.1.1",
        "network": "tcp,udp",
        "port": 53
      },
      "tag": "dns-in"
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "89.169.53.176",
            "port": 4443,
            "users": [
              {
                "id": "20dd9433-389e-4573-ba7b-689619cf13da",
